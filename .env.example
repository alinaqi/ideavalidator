# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Grounded research model (web search). Default: gemini-3.1-pro-preview
GEMINI_MODEL=
# Cheap structuring model (JSON extraction). Default: gemini-3.8-flash
GEMINI_STRUCTURE_MODEL=
# Optional Deep Research agent for --deep runs. Default: deep-research-preview-04-2026
GEMINI_DEEP_RESEARCH_AGENT=

# --- Sounding board (optional, multi-model debate) ---
# Either point at an existing env file holding provider keys...
KEYS_FILE=
# ...or set the ones you have. Any subset works; personas fall back to available models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
# External keys file for the sounding board (alias for KEYS_FILE, read first)
IDEAVALIDATOR_KEYS_FILE=
# Hosted server run-store directory (default: <repo>/server_runs)
IV_STORE=
# Demand signals (optional; all degrade gracefully if unset)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
APIFY_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Palgu single-key mode (run `palgu login` instead of setting these by hand)
PALGU_API_KEY=
PALGU_GATEWAY=
PALGU_MODEL=

# --- Rust web app + hosted MCP (web/) ---
# HTTP port the Rust service binds (default: 8000)
PORT=
# Postgres connection string for accounts + run history (e.g. postgres://user:pass@host:5432/db)
DATABASE_URL=
# Palgu API origin for the native device-code sign-in (default: https://api.palgu.ai)
PALGU_ORIGIN=
# 32-byte key, base64 or hex, for encrypting each user's Palgu token at rest. Generate a random one;
# never commit a real value. Rotating it invalidates stored tokens (users re-sign-in).
# e.g. `openssl rand -hex 32` or `openssl rand -base64 32`
TOKEN_ENC_KEY=
# Python interpreter the Rust service spawns the worker with (default: .venv/bin/python locally;
# the Docker image sets this to python3).
PYTHON_BIN=
# Max validation runs allowed to execute concurrently (tokio semaphore bound; default: 3).
MAX_CONCURRENT_RUNS=
