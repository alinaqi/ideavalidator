# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Grounded research model (web search). Default: gemini-3.1-pro-preview
GEMINI_MODEL=
# Cheap structuring model (JSON extraction). Default: gemini-3.8-flash
GEMINI_STRUCTURE_MODEL=
# Optional Deep Research agent for --deep runs. Default: deep-research-preview-04-2026
GEMINI_DEEP_RESEARCH_AGENT=

# --- Sounding board (optional, multi-model debate) ---
# Either point at an existing env file holding provider keys...
KEYS_FILE=
# ...or set the ones you have. Any subset works; personas fall back to available models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
# Demand signals (optional; all degrade gracefully if unset)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
APIFY_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Palgu single-key mode (run `palgu login` instead of setting these by hand)
PALGU_API_KEY=
PALGU_GATEWAY=
PALGU_MODEL=
